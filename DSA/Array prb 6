Reverse the order of elements in an array

#include <stdio.h>

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int n = 5;

    printf("Original: ");
    for(int i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\nReversed: ");
    for(int i = n - 1; i >= 0; i--)
        printf("%d ", arr[i]);

    return 0;
}
