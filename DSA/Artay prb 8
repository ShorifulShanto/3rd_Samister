Insert a new element at a specific position within an array.

#include <stdio.h>

int main() {
    int arr[10] = {10, 20, 30, 40, 50};
    int n = 5;
    int pos = 2; 
    int newElement = 25;

    for(int i = n; i > pos; i--)
        arr[i] = arr[i - 1];
    arr[pos] = newElement;
    n++;

    printf("Array: ");
    for(int i = 0; i < n; i++)
        printf("%d ", arr[i]);

    return 0;
}
